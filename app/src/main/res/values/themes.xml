        <item name="colorPrimary">@color/verde_institucional</item>
        <item name="colorPrimaryVariant">@color/verde_oscuro_institucional</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/dorado_institucional</item>
        <item name="colorSecondaryVariant">@color/dorado_institucional</item>
        <item name="colorOnSecondary">@color/verde_oscuro_institucional</item>
